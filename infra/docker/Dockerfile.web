# Step 1: Base builder environment
FROM node:20-alpine AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

FROM base AS builder
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter multiplus-web build

# Step 2: Runtime image configuration
FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

COPY --from=builder /app /app
USER nextjs

EXPOSE 3000
ENV PORT=3000

CMD ["pnpm", "--filter", "multiplus-web", "start"]
